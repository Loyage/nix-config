# Ghostty 配置：尽量与 Kitty 保持一致

# 字体与终端类型
font-family = Maple Mono NF CN
font-style = Medium
font-size = 14
term = xterm-256color

# Shell / 工作目录
window-inherit-working-directory = true
working-directory = inherit

# 滚动
scrollback-limit = 10000000

# 外观
window-decoration = false
macos-titlebar-style = hidden
background = #282c34
foreground = #979eab
background-opacity = 0.9
background-blur = 30
window-padding-x = 8
window-padding-y = 8
window-padding-balance = true
alpha-blending = linear-corrected
cursor-color = #979eab
cursor-text = #282c34
selection-foreground = #282c34
selection-background = #abb2bf

# One Dark 色板
palette = 0=#282c34
palette = 1=#e06c75
palette = 2=#98c379
palette = 3=#e5c07b
palette = 4=#61afef
palette = 5=#be5046
palette = 6=#56b6c2
palette = 7=#979eab
palette = 8=#393e48
palette = 9=#d19a66
palette = 10=#56b6c2
palette = 11=#e5c07b
palette = 12=#61afef
palette = 13=#be5046
palette = 14=#56b6c2
palette = 15=#abb2bf

# 标签页与行为
gtk-tabs-location = bottom
window-show-tab-bar = always
confirm-close-surface = false
clipboard-read = allow
clipboard-write = allow
copy-on-select = true
link-url = true

# 快速终端（Super+` 切换）
quick-terminal-position = top
quick-terminal-size = 50%,100%
quick-terminal-screen = main
quick-terminal-animation-duration = 0.2
quick-terminal-autohide = true
quick-terminal-space-behavior = move
keybind = global:super+backquote=toggle_quick_terminal

# 平台行为
macos-option-as-alt = true
macos-window-shadow = true
gtk-single-instance = detect

# 快捷键（与 config/kitty/keymaps.conf 对齐）
keybind = super+t=new_tab
keybind = alt+t=new_tab
keybind = super+w=close_surface
keybind = alt+w=close_surface
keybind = super+shift+i=prompt_tab_title
keybind = alt+shift+i=prompt_tab_title
keybind = ctrl+shift+alt+t=prompt_tab_title
keybind = ctrl+shift+k=move_tab:1
keybind = ctrl+shift+j=move_tab:-1
keybind = super+1=goto_tab:1
keybind = super+2=goto_tab:2
keybind = super+3=goto_tab:3
keybind = super+4=goto_tab:4
keybind = super+5=goto_tab:5
keybind = super+6=goto_tab:6
keybind = super+7=goto_tab:7
keybind = super+8=goto_tab:8
keybind = super+9=goto_tab:9
keybind = super+0=goto_tab:10
keybind = super+p=previous_tab
keybind = alt+1=goto_tab:1
keybind = alt+2=goto_tab:2
keybind = alt+3=goto_tab:3
keybind = alt+4=goto_tab:4
keybind = alt+5=goto_tab:5
keybind = alt+6=goto_tab:6
keybind = alt+7=goto_tab:7
keybind = alt+8=goto_tab:8
keybind = alt+9=goto_tab:9
keybind = alt+0=goto_tab:10
keybind = alt+p=previous_tab
